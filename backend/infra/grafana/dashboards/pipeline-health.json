{
  "uid": "sephela-pipeline-health",
  "title": "Sephela — Pipeline Health",
  "description": "Is the analysis pipeline keeping up, and where is it failing? Start here during an incident.",
  "tags": ["sephela", "pipeline"],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "stage",
        "label": "Stage",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(sephela_stage_total, stage)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Throughput and outcomes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Jobs completed per minute, by outcome",
      "description": "`partial` is expected on any deployment running a subset of stages — it is not an error rate. Watch its ratio to `completed` rather than its absolute value.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "jobs/min" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(sephela_jobs_total[5m])) * 60",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Job failure ratio (1h)",
      "description": "Failed jobs as a share of all terminal jobs. `partial` is deliberately excluded: a stage being disabled is a configuration choice, not a failure.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(sephela_jobs_total{status=\"failed\"}[1h])) / clamp_min(sum(increase(sephela_jobs_total[1h])), 1)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Job p95 duration (1h)",
      "description": "End-to-end, from intake to finalize. Dominated by decompilation on any deployment with JADX installed.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sephela_job_duration_seconds_bucket[1h])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Sampled from the broker every 30s. A queue that climbs without falling means the workers for that class are saturated; KEDA scales on this signal.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (sephela_queue_depth)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Stages",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Stage outcomes per minute",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "ops/min" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, status) (rate(sephela_stage_total{stage=~\"$stage\"}[5m])) * 60",
          "legendFormat": "{{stage}} {{status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Stage p95 duration",
      "description": "The 300s and 600s bucket boundaries bracket the Celery soft time limits — a stage approaching them is about to be killed rather than merely slow.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(sephela_stage_duration_seconds_bucket{stage=~\"$stage\"}[10m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Stage failure rate",
      "description": "Per-stage failures per minute. A single stage failing while the rest are healthy usually means its tool is missing from that worker's image.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "ops/min" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(sephela_stage_total{status=\"failed\", stage=~\"$stage\"}[5m])) * 60",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Stage retries",
      "description": "A stage that regularly succeeds only on a later attempt is unreliable even though its success rate looks fine.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "ops/min" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(sephela_stage_retries_total{stage=~\"$stage\"}[10m])) * 60",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "API",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "API request rate by status",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "API p95 latency by route",
      "description": "Paths are normalised to `{id}`, so one line covers every job.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{path}}"
        }
      ]
    }
  ]
}
