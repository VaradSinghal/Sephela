# ---- Application ----
SEPHELA_ENV=local                       # local|dev|staging|prod
SEPHELA_DEBUG=true
SEPHELA_LOG_LEVEL=INFO
SEPHELA_LOG_JSON=false                   # false=pretty console (dev), true=JSON (prod)
SEPHELA_API_V1_PREFIX=/api/v1
SEPHELA_PROJECT_NAME=Sephela

# ---- Security (placeholder auth — Phase 2) ----
SEPHELA_SECRET_KEY=change-me-in-prod-use-a-32+char-random-string
SEPHELA_ACCESS_TOKEN_EXPIRE_MINUTES=30
SEPHELA_ALGORITHM=HS256
# comma-separated origins; * only for local
SEPHELA_CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL, async) ----
SEPHELA_POSTGRES_HOST=localhost
SEPHELA_POSTGRES_PORT=5432
SEPHELA_POSTGRES_USER=sephela
SEPHELA_POSTGRES_PASSWORD=sephela
SEPHELA_POSTGRES_DB=sephela

# ---- Redis (Celery broker + result backend + cache) ----
SEPHELA_REDIS_HOST=localhost
SEPHELA_REDIS_PORT=6379
SEPHELA_REDIS_DB=0

# ---- Storage (APK + artifacts) ----
SEPHELA_STORAGE_BACKEND=local            # local|s3 (s3 wired in a later phase)
SEPHELA_STORAGE_LOCAL_ROOT=./data/storage
# SEPHELA_S3_ENDPOINT_URL=http://localhost:9000
# SEPHELA_S3_BUCKET=sephela-samples
# SEPHELA_S3_ACCESS_KEY=
# SEPHELA_S3_SECRET_KEY=
# SEPHELA_S3_REGION=us-east-1

# ---- Upload / pipeline ----
SEPHELA_MAX_UPLOAD_BYTES=314572800       # 300 MiB
SEPHELA_PIPELINE_VERSION=2026.1

# ---- Dynamic analysis / sandbox (Phase 10) ----
# The sandbox EXECUTES MALWARE. Enable only on a KVM-capable, egress-firewalled
# host — see infra/sandbox/README.md and docs/architecture/09-security.md.
SEPHELA_DYNAMIC_ENABLED=false
SEPHELA_SANDBOX_RUNNER=disabled          # disabled|compose|script
SEPHELA_SANDBOX_DIR=../infra/sandbox
SEPHELA_SANDBOX_TIMEOUT_SECS=180         # in-emulator observation budget
SEPHELA_SANDBOX_TIMEOUT_GRACE_SECS=300   # extra wall-clock for boot + cleanup
SEPHELA_SANDBOX_API_LEVEL=33
SEPHELA_DYNAMIC_ARTIFACTS_ROOT=./data/dynamic
SEPHELA_DYNAMIC_KEEP_ARTIFACTS=false     # true only for debugging
