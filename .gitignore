dist/
# tsc's incremental cache. Tracked by mistake: it is regenerated by every
# typecheck/build, so it appears in the diff of every unrelated change.
*.tsbuildinfo

# Engine scratch space — decompiled trees derived from malware samples.
data/

# OS / editor
.DS_Store
.idea/

# Python build output. `pip wheel`/`python -m build` writes build/ and dist/ next to
# the pyproject.toml being built; linting them re-reports every finding in a copy of
# the source, and committing them ships stale duplicates.
build/
dist/
*.whl
generate_apk.py
test_malware.apk
ApiDemos-debug.apk