# ==============================================================================
# Sephela - Local Development
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
SEPHELA_ENV=local
SEPHELA_DEBUG=true
SEPHELA_PROJECT_NAME=Sephela
SEPHELA_API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
SEPHELA_POSTGRES_HOST=localhost
SEPHELA_POSTGRES_PORT=5432
SEPHELA_POSTGRES_USER=sephela
SEPHELA_POSTGRES_PASSWORD=sephela
SEPHELA_POSTGRES_DB=sephela

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
SEPHELA_REDIS_HOST=localhost
SEPHELA_REDIS_PORT=6379
SEPHELA_REDIS_DB=0

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
# `local` puts bytes on the worker's own disk, which is correct for a single-process
# laptop stack and wrong for anything else: with two workers, the stage that stored the
# sample and the stage that reads it are only sometimes the same machine. Any env other
# than `local` refuses to boot on it (app/core/config.py::assert_production_ready).
SEPHELA_STORAGE_BACKEND=local
SEPHELA_STORAGE_LOCAL_ROOT=./data/storage

# S3-compatible object storage — AWS S3, or MinIO for a self-hosted deployment.
# SEPHELA_STORAGE_BACKEND=s3
# SEPHELA_S3_BUCKET=sephela-samples
# SEPHELA_S3_REGION=us-east-1
#
# Set the endpoint for MinIO or any non-AWS S3; leave it unset for AWS. Its presence is
# also what switches the client to path-style addressing, which MinIO requires.
# SEPHELA_S3_ENDPOINT_URL=http://localhost:9000
#
# Leave the keys unset on EKS with IRSA or EC2 with an instance profile — boto3 resolves
# the role credentials itself, and hardcoding a key pair there is strictly worse.
# SEPHELA_S3_ACCESS_KEY=
# SEPHELA_S3_SECRET_KEY=

# Upper bound on the decompiled-source archive handed from the static stage to code
# intel through object storage. Over it, the archive is skipped and code intel runs
# without the JADX tree — losing call-graph and control-flow depth, never correctness.
# SEPHELA_MAX_DECOMPILED_ARCHIVE_BYTES=268435456

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# Signs every token. Outside SEPHELA_ENV=local the app refuses to start while this
# is still the literal default "change-me" (app.core.config.assert_production_ready).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SEPHELA_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_32_PLUS_CHAR_SECRET
SEPHELA_ALGORITHM=HS256
# Access tokens are short-lived; refresh tokens carry the session and rotate on use.
SEPHELA_ACCESS_TOKEN_EXPIRE_MINUTES=30
SEPHELA_REFRESH_TOKEN_EXPIRE_DAYS=7
SEPHELA_CORS_ORIGINS=http://localhost:3000

# There is no self-service registration — provision the first tenant and admin with
#   make bootstrap-admin ORG="Example Bank" EMAIL=admin@bank.example
# Passwords are never passed as arguments; set SEPHELA_INITIAL_PASSWORD or let the
# CLI generate and print one.

# ------------------------------------------------------------------------------
# Rate limiting (DoS + cost control)
# ------------------------------------------------------------------------------
# Per-principal (per authenticated user, falling back to client IP), counted in
# Redis. Fails open: if Redis is unreachable, requests are allowed rather than
# turning a protective control into an outage.
SEPHELA_RATE_LIMIT_ENABLED=true
SEPHELA_RATE_LIMIT_REQUESTS=300
SEPHELA_RATE_LIMIT_WINDOW_SECONDS=60
# Uploads get their own tighter bucket — one upload costs minutes of sandbox and
# LLM work, so it must not share an allowance with cheap status polls.
SEPHELA_RATE_LIMIT_UPLOAD_REQUESTS=20
SEPHELA_RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# Threat Intelligence (Phase 11)
# ------------------------------------------------------------------------------
# Enabled by default: URLhaus answers without a key, so the stage produces real
# evidence with no keys at all. Adding keys widens coverage.
SEPHELA_THREAT_INTEL_ENABLED=true

# Provider API keys — an absent key omits that provider rather than failing.
SEPHELA_VIRUSTOTAL_API_KEY=
SEPHELA_OTX_API_KEY=
SEPHELA_ABUSEIPDB_API_KEY=
# URLhaus is keyless. MalwareBazaar now requires an Auth-Key, so leaving this
# blank omits the hash feed rather than 401-ing on every lookup.
SEPHELA_URLHAUS_API_KEY=
SEPHELA_BAZAAR_API_KEY=

# Cost controls. max_lookups caps *live* calls per job (cache hits are free), so
# one pathological sample cannot drain a day's free quota.
SEPHELA_THREAT_INTEL_MAX_LOOKUPS=200
SEPHELA_THREAT_INTEL_CONCURRENCY=8
SEPHELA_THREAT_INTEL_TIMEOUT_SECS=20
SEPHELA_THREAT_INTEL_BREAKER_THRESHOLD=4
# Multiplier on the engine's per-IoC cache TTLs (hashes ~7d, domains/IPs ~6-12h).
# Raise it to stretch a small quota; lower it to re-check verdicts more often.
SEPHELA_THREAT_INTEL_CACHE_TTL_FACTOR=1.0

# ------------------------------------------------------------------------------
# LLM Providers
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Optional
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_BASE_URL=

# ------------------------------------------------------------------------------
# Agent Models
# ------------------------------------------------------------------------------
# Per-agent model override. Unset means claude-opus-5 (see ai/integration.py).
# Values are passed to the configured provider verbatim, so a `vendor/model` slug
# here routes via OpenRouter and a bare id goes to the first-party API.
MANIFEST_MODEL=claude-opus-5
PERMISSION_MODEL=claude-opus-5
CODE_MODEL=claude-opus-5
API_MODEL=claude-opus-5
NETWORK_MODEL=claude-opus-5
THREAT_INTEL_MODEL=claude-opus-5
RISK_MODEL=claude-opus-5
REPORT_MODEL=claude-opus-5

# ------------------------------------------------------------------------------
# LLM Runtime
# ------------------------------------------------------------------------------
LLM_PROVIDER=openrouter
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# RAG / Knowledge Service (Phase 12)
# ------------------------------------------------------------------------------
# Enabled by default and zero-configuration: the deterministic hashing embedder
# needs no API key and the in-memory store needs no database, so the RAG path runs
# anywhere. Set RAG_ENABLED=false to remove reference knowledge from prompts.
RAG_ENABLED=true
RAG_TOP_K=5
# Ceiling on the reference block. Retrieved knowledge competes with evidence for
# prompt space, and evidence must win.
RAG_MAX_CONTEXT_TOKENS=1200

# Embeddings. Leave RAG_EMBEDDING_MODEL empty for the offline hashing embedder,
# which matches exact vocabulary (family names, permission constants, MITRE ids)
# but not paraphrases. Set a model for semantic recall; any OpenAI-compatible
# /v1/embeddings endpoint works, including self-hosted vLLM/Ollama.
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_API_KEY=
# Must match the embedding model's output size (hashing: 512, OpenAI small: 1536).
RAG_DIMENSIONS=512

# Vector store: `memory` (default) or `qdrant`. Brute-force in-memory search beats
# a network round trip for a few thousand chunks; switch when the corpus outgrows it.
RAG_VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sephela_knowledge
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# LangGraph / Agents
# ------------------------------------------------------------------------------
AGENT_ENABLE_PARALLEL=true
AGENT_MAX_CONCURRENCY=8

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
SEPHELA_LOG_LEVEL=INFO
SEPHELA_LOG_JSON=false

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1